# The producer loop on the GCP VM (infra/alchemy.run.ts), installed by
# deploy/gcp/apply.sh. The same command as deploy/k8s/deployment.yaml on
# fafo-0, writing to the Cloud Storage bucket instead of R2.
#
# Checkpoint: the page's default root (browser/src/main.ts, viz.ts), here so
# the producer publishes head/bootstrap/<root>. state.json is tied to it, so
# moving it means a fresh work directory: stop the service, move
# /data/produce aside (/data/produce-<old root prefix>), then apply.sh.
#
# /etc/csl-eth/fcr.env (optional, root-only, written by hand) holds
# CSL_ETH_FCR_RPC; its URL may carry an API key, and the producer only ever
# prints its host.
#
# Cycles: one JSON line each in the journal (journalctl -u csl-eth-producer)
# and in /data/produce/produce.log.
[Unit]
Description=csl-eth producer (1/4096 mainnet slice to gs://csl-eth-demo)
Wants=network-online.target
After=network-online.target

[Service]
User=csl
Group=csl
WorkingDirectory=/opt/csl-eth
Environment=HOME=/data/home
Environment=CSL_ETH_GCS_BUCKET=csl-eth-demo
EnvironmentFile=-/etc/csl-eth/fcr.env
Nice=10
ExecStart=/opt/csl-eth/target/release/csl-eth produce \
  --prefix 1a7 \
  --work /data/produce \
  --checkpoint 0x431b33af8452e2d644377405e69d4f382182ab906f31461190ca24cb3401d70b \
  --publish /opt/csl-eth/scripts/gcs-publish.sh \
  --every-mins 6 \
  --keep 10 \
  --lead-secs 60
Restart=always
RestartSec=30
MemoryMax=3G

[Install]
WantedBy=multi-user.target
